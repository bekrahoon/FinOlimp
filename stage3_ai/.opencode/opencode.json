{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "reconcile",
  "mcp": {
    "servers": {
      "finolimp": {
        "type": "local",
        "command": ["uv", "run", "python", "-m", "finolimp_mcp"],
        "cwd": "integrations/finolimp_mcp",
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 900000
        }
      }
    }
  }
}
